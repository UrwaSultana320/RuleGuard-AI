# Server-only credentials; set privately in .env.local or Vercel.
# All three are required for live AI; leave Gemini empty for extraction only.
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional model ID; empty disables fallback.
GEMINI_FALLBACK_MODEL=

# Local test settings only; do not set these in Vercel.
# PLAYWRIGHT_BASE_URL=
# PLAYWRIGHT_CHROME_PATH=
